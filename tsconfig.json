{
    "compilerOptions": {
        "rootDir": "./src/",
        "outDir": "./dist/",
        "target": "ES2022",
        "module": "preserve",
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "moduleResolution": "bundler",
        "experimentalDecorators": true
    },
    "include": ["./src/**/*"]
}